<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="011-unprefix-console-routes" author="susimsek">
        <update tableName="oauth2_registered_client">
            <column name="redirect_uris" value="http://localhost:9090/admin/callback,https://spring-authorization-server-samples.local/admin/callback"/>
            <column name="post_logout_redirect_uris" value="http://localhost:9090/admin/,https://spring-authorization-server-samples.local/admin/"/>
            <where>id = 'admin-console'</where>
        </update>
        <update tableName="oauth2_registered_client">
            <column name="redirect_uris" value="http://localhost:9090/account/callback,https://spring-authorization-server-samples.local/account/callback"/>
            <column name="post_logout_redirect_uris" value="http://localhost:9090/account/,https://spring-authorization-server-samples.local/account/"/>
            <where>id = 'account-console'</where>
        </update>
    </changeSet>
</databaseChangeLog>
