<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="012-01-mfa-settings" author="susimsek">
        <addColumn tableName="users">
            <column name="totp_secret" type="varchar(64)"/>
            <column name="totp_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="mfa_failed_attempt_count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="mfa_permanently_locked" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="login_settings">
            <column name="otp_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="otp_required" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="otp_issuer" type="varchar(100)" defaultValue="Spring Authorization Server">
                <constraints nullable="false"/>
            </column>
            <column name="otp_algorithm" type="varchar(10)" defaultValue="SHA1">
                <constraints nullable="false"/>
            </column>
            <column name="otp_digits" type="int" defaultValueNumeric="6">
                <constraints nullable="false"/>
            </column>
            <column name="otp_period_seconds" type="int" defaultValueNumeric="30">
                <constraints nullable="false"/>
            </column>
            <column name="otp_look_ahead_window" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="012-02-mfa-reusable-code" author="susimsek">
        <addColumn tableName="login_settings">
            <column name="otp_code_reusable" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="brute_force_max_secondary_failures" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="otp_add_recovery_codes" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="recovery_code_warning_threshold" type="int" defaultValueNumeric="2">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
