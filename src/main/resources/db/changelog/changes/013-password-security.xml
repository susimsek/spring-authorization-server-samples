<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="013-01-password-security-columns" author="codex">
		<addColumn tableName="users">
			<column name="password_changed_at" type="timestamp"/>
			<column name="must_change_password" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="temporary_password" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="failed_login_count" type="bigint" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="last_failed_login_at" type="timestamp"/>
			<column name="locked_until" type="timestamp"/>
			<column name="temporary_lockout_count" type="bigint" defaultValueNumeric="0">
				<constraints nullable="false"/>
			</column>
			<column name="permanently_locked" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</addColumn>
		<update tableName="users">
			<column name="password_changed_at" valueDate="${now}"/>
			<where>password_changed_at is null</where>
		</update>
	</changeSet>

	<changeSet id="013-02-password-history" author="codex">
		<createSequence sequenceName="password_history_seq" startValue="1" incrementBy="1"/>
		<createTable tableName="password_history">
			<column name="id" type="bigint">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_password_history"/>
			</column>
			<column name="user_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="password_hash" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint baseTableName="password_history" baseColumnNames="user_id"
				constraintName="fk_password_history_user" referencedTableName="users" referencedColumnNames="id"
			onDelete="CASCADE"/>
		<createIndex tableName="password_history" indexName="ix_password_history_user_created">
			<column name="user_id"/>
			<column name="created_at" descending="true"/>
		</createIndex>
	</changeSet>

	<changeSet id="013-03-password-required-action" author="codex">
		<insert tableName="required_action_definition">
			<column name="action_key" value="UPDATE_PASSWORD"/>
			<column name="display_name" value="Update password"/>
			<column name="description" value="Choose a new password before continuing."/>
			<column name="enabled" valueBoolean="true"/>
			<column name="global_policy" valueBoolean="true"/>
			<column name="version" valueNumeric="1"/>
			<column name="priority" valueNumeric="5"/>
			<column name="created_by" value="system"/>
			<column name="created_at" valueDate="${now}"/>
			<column name="updated_at" valueDate="${now}"/>
		</insert>
	</changeSet>
</databaseChangeLog>
